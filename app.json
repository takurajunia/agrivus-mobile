{
  "expo": {
    "name": "Agrivus",
    "slug": "agrivus-mobile",
    "version": "1.0.7",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrivus.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.agrivus.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Agrivus needs access to your photo library so you can select a profile picture and upload images for your marketplace listings.",
          "cameraPermission": "Agrivus needs access to your camera so you can take a profile picture or capture photos of products to upload to your marketplace listings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "agrivus-tech-solutions-wu",
          "project": "agrivus-mobile"
        }
      ]
    ],
    "scheme": "agrivus",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea0e53db-35ca-4283-89cd-4cf182c6061c"
      }
    }
  }
}
